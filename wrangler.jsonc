{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "little-library",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-11-16",
  "upload_source_maps": true,
  // Workers Logs: request URLs, statuses and console output, kept for a few days. The free plan covers this traffic.
  // Traces stay off: a future Cloudflare default may turn them on, and they record outbound request URLs.
  "observability": { "enabled": true, "traces": { "enabled": false } },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "books.waffle.haus", "custom_domain": true }],
  "vars": { "SITE_URL": "https://books.waffle.haus" },
  "secrets": { "required": ["GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET", "ALLOWLIST_EMAILS", "ADMIN_EMAILS"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "little-library", "database_id": "9488eb22-6688-4859-9f13-07e9b04a39cb", "migrations_dir": "drizzle", "migrations_pattern": "drizzle/*/migration.sql" }
  ]
}
